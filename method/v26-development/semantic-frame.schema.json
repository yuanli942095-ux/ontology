{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://w3id.org/ontology-evolution/ecr-repair/semantic-frame-v1",
  "title": "ECR-Repair candidate-blind semantic frame",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "event_id", "frames"],
  "properties": {
    "schema_version": {"const": "semantic-frame-v1"},
    "event_id": {"type": "string", "minLength": 1},
    "frames": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["document_id", "window_id", "quote", "subject", "predicate", "value", "modality", "assertion_kind", "authority", "confidence"],
        "properties": {
          "document_id": {"type": "string", "minLength": 1},
          "window_id": {"type": "string", "pattern": "^SOURCE_WINDOW_[0-9]+$"},
          "quote": {"type": "string", "minLength": 1},
          "subject": {"type": "string", "minLength": 1},
          "predicate": {"type": "string", "minLength": 1},
          "value": {"type": "string", "minLength": 1},
          "modality": {"enum": ["MUST", "MUST_NOT", "SHOULD", "SHOULD_NOT", "MAY", "DESCRIPTIVE"]},
          "conditions": {"type": "array", "items": {"type": "string"}, "default": []},
          "exceptions": {"type": "array", "items": {"type": "string"}, "default": []},
          "valid_from": {"type": ["string", "null"], "format": "date-time"},
          "valid_to": {"type": ["string", "null"], "format": "date-time"},
          "jurisdiction": {"type": ["string", "null"]},
          "assertion_kind": {"enum": ["NORMATIVE", "INFORMATIVE", "REFERENCE", "METADATA", "TABLE"]},
          "authority": {"type": "integer", "minimum": 0},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1}
        }
      }
    }
  }
}
